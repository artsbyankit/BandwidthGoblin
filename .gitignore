# Runtime artifacts - never commit these
__pycache__/
*.pyc
logs/
perf.jsonl
history.jsonl
.lastdir
.uimode
*.resume
*.resume.tmp
*.progress

# YouTube engine downloads (yt-dlp/deno/ffmpeg) - fetched on first use
tools/

# Platform packs (pack/*) carry their own runtime state when run in place
pack/*/logs/
pack/*/perf.jsonl
pack/*/history.jsonl
pack/*/.lastdir
pack/*/.uimode
pack/*/__pycache__/
pack/*/*.pyc

# OS junk
.DS_Store
Thumbs.db